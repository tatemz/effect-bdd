{
  "$schema": "https://unpkg.com/knip@6/schema-jsonc.json",
  "ignoreDependencies": [
    // Babel resolves this plugin from the CLI flag in the `babel` package script.
    "babel-plugin-annotate-pure-calls"
  ],
  "workspaces": {
    ".": {
      "entry": [
        // Step modules are loaded by glob at runtime in CLI tests.
        "test/fixtures/*.step.ts",
        // Tstyche discovers these through `tstyche.json`.
        "typetest/**/*.tst.ts",
        // Oxlint's JS plugin test harness discovers these directly.
        "oxlint-rules/**/*.test.mjs"
      ],
      "project": [
        "src/**/*.ts",
        "test/**/*.ts",
        "typetest/**/*.tst.ts",
        "scripts/**/*.mjs",
        "oxlint-rules/**/*.mjs"
      ]
    },
    "examples": {
      "entry": [
        "counter.ts",
        "counter.steps.ts"
      ],
      "project": [
        "*.ts"
      ]
    }
  }
}
