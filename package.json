{
  "name": "effect-bdd",
  "version": "0.3.0",
  "type": "module",
  "license": "MIT",
  "description": "An Effect-native API for testing Gherkin feature files",
  "homepage": "https://github.com/tatemz/effect-bdd#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tatemz/effect-bdd.git"
  },
  "bugs": {
    "url": "https://github.com/tatemz/effect-bdd/issues"
  },
  "tags": [
    "bdd",
    "gherkin",
    "testing",
    "typescript",
    "algebraic-data-types",
    "functional-programming"
  ],
  "keywords": [
    "bdd",
    "gherkin",
    "testing",
    "typescript",
    "algebraic-data-types",
    "functional-programming"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "packageManager": "pnpm@10.16.1",
  "sideEffects": [],
  "bin": {
    "effect-bdd": "./dist/bin.js"
  },
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./Bdd": {
      "types": "./dist/Bdd.d.ts",
      "default": "./dist/Bdd.js"
    },
    "./Errors": {
      "types": "./dist/Errors.d.ts",
      "default": "./dist/Errors.js"
    },
    "./bin": null,
    "./main": null,
    "./internal/*": null,
    "./*/index": null
  },
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && pnpm babel",
    "babel": "babel dist --plugins annotate-pure-calls --out-dir dist",
    "check": "tsc -p tsconfig.json --noEmit",
    "lint": "pnpm lint:grit-fixtures && pnpm lint:biome",
    "lint:biome": "biome lint .",
    "lint:grit-fixtures": "node scripts/lint-grit-fixtures.mjs",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "test": "vitest run",
    "test:types": "tstyche",
    "test:examples": "node scripts/check-examples.mjs",
    "ci": "pnpm build && pnpm lint && pnpm format:check && pnpm test && pnpm test:types && pnpm test:examples",
    "prepack": "pnpm build"
  },
  "peerDependencies": {
    "effect": "^4.0.0-beta.78"
  },
  "dependencies": {
    "@cucumber/gherkin": "^39.1.0",
    "@cucumber/messages": "^32.3.1",
    "@effect/platform-node": "4.0.0-beta.78"
  },
  "devDependencies": {
    "@babel/cli": "^7.29.7",
    "@biomejs/biome": "^2.4.16",
    "@effect/vitest": "4.0.0-beta.78",
    "@types/node": "^25.9.2",
    "babel-plugin-annotate-pure-calls": "^0.5.0",
    "effect": "4.0.0-beta.78",
    "tstyche": "^7.2.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts"
}
