{
  "name": "effect-bdd",
  "version": "0.5.0",
  "description": "An Effect-native API for testing Gherkin feature files",
  "keywords": [
    "algebraic-data-types",
    "bdd",
    "functional-programming",
    "gherkin",
    "testing",
    "typescript"
  ],
  "homepage": "https://github.com/tatemz/effect-bdd#readme",
  "bugs": {
    "url": "https://github.com/tatemz/effect-bdd/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tatemz/effect-bdd.git"
  },
  "bin": {
    "effect-bdd": "dist/bin.js"
  },
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts"
  ],
  "type": "module",
  "sideEffects": [],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./Bdd": {
      "types": "./dist/Bdd.d.ts",
      "default": "./dist/Bdd.js"
    },
    "./Errors": {
      "types": "./dist/Errors.d.ts",
      "default": "./dist/Errors.js"
    },
    "./bin": null,
    "./main": null,
    "./internal/*": null,
    "./*/index": null
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && pnpm babel",
    "babel": "babel dist --plugins annotate-pure-calls --out-dir dist",
    "bench": "pnpm --dir benchmarks run bench",
    "bench:compare": "pnpm --dir benchmarks run compare",
    "bench:compiled": "pnpm --dir benchmarks run compare:compiled",
    "bench:pressure": "pnpm --dir benchmarks run pressure",
    "bench:report": "pnpm --dir benchmarks run report",
    "bench:smoke": "pnpm --dir benchmarks run smoke",
    "check": "tsc -p tsconfig.json --noEmit",
    "lint": "pnpm lint:oxlint && pnpm lint:package-boundaries && pnpm lint:knip",
    "lint:oxlint": "oxlint . --deny-warnings",
    "lint:package-boundaries": "depcruise --config .dependency-cruiser.js --output-type err src test scripts examples benchmarks oxlint-rules",
    "lint:knip": "knip --config knip.jsonc",
    "format": "oxfmt .",
    "format:check": "oxfmt . --check",
    "test": "vitest run",
    "test:types": "tstyche",
    "test:examples": "node scripts/check-examples.mjs",
    "test:examples:run": "pnpm --dir examples test",
    "ci": "pnpm build && pnpm lint && pnpm format:check && pnpm test && pnpm test:types && pnpm test:examples && pnpm test:examples:run",
    "prepack": "pnpm build"
  },
  "dependencies": {
    "@cucumber/gherkin": "^39.1.0",
    "@cucumber/messages": "^32.3.1",
    "@effect/platform-node": "4.0.0-beta.90"
  },
  "devDependencies": {
    "@babel/cli": "^7.29.7",
    "@effect/vitest": "4.0.0-beta.90",
    "@types/node": "^25.9.2",
    "babel-plugin-annotate-pure-calls": "^0.5.0",
    "dependency-cruiser": "^17.4.3",
    "effect": "4.0.0-beta.90",
    "knip": "^6.16.1",
    "oxfmt": "^0.54.0",
    "oxlint": "^1.69.0",
    "tstyche": "^7.2.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8"
  },
  "peerDependencies": {
    "effect": "^4.0.0-beta.90"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "pnpm@10.16.1",
  "tags": [
    "bdd",
    "gherkin",
    "testing",
    "typescript",
    "algebraic-data-types",
    "functional-programming"
  ]
}
