{
  "name": "effect-bdd-workspace",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm --recursive --parallel --filter \"./packages/*\" run build",
    "check": "pnpm --recursive --parallel --filter \"./packages/*\" run check",
    "lint": "pnpm lint:oxlint && pnpm lint:package-boundaries && pnpm lint:knip",
    "lint:oxlint": "oxlint . --deny-warnings",
    "lint:package-boundaries": "depcruise --config .dependency-cruiser.js --output-type err packages/effect-bdd/src packages/effect-bdd/test packages/effect-bdd/scripts packages/hello/src examples benchmarks oxlint-rules",
    "lint:knip": "knip --config knip.jsonc",
    "format": "oxfmt .",
    "format:check": "oxfmt . --check",
    "test": "pnpm --filter effect-bdd test",
    "test:types": "pnpm --filter effect-bdd test:types",
    "test:examples": "pnpm --filter effect-bdd test:examples",
    "test:examples:run": "pnpm --dir examples test",
    "bench": "pnpm --dir benchmarks run bench",
    "bench:compare": "pnpm --dir benchmarks run compare",
    "bench:compiled": "pnpm --dir benchmarks run compare:compiled",
    "bench:pressure": "pnpm --dir benchmarks run pressure",
    "bench:report": "pnpm --dir benchmarks run report",
    "bench:smoke": "pnpm --dir benchmarks run smoke",
    "ci": "pnpm build && pnpm lint && pnpm format:check && pnpm test && pnpm test:types && pnpm test:examples && pnpm test:examples:run",
    "publish:packages": "pnpm --recursive --filter \"./packages/*\" publish --access public --provenance --no-git-checks"
  },
  "devDependencies": {
    "@types/node": "^25.9.2",
    "dependency-cruiser": "^17.4.3",
    "knip": "^6.32.2",
    "oxfmt": "^0.64.0",
    "oxlint": "^1.79.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11"
  },
  "packageManager": "pnpm@10.16.1"
}
