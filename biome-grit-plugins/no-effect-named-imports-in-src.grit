engine biome(1.0)
language js(typescript, jsx)

JsImport() as $import where {
  $import <: contains JsModuleSource() as $source,
  $source <: r"^['\"](?:effect|@effect/[a-z-]+)['\"]$",
  $import <: or {
    not contains JsImportNamespaceClause(),
    contains JsImportDefaultClause()
  },
  register_diagnostic(span=$import, message="Import Effect modules through subpath namespace imports (for example: import * as Effect from \"effect/Effect\").")
}
