engine biome(1.0)
language js(typescript, jsx)

or {
  `$receiver.charAt($...)` as $call,
  `$receiver.charCodeAt($...)` as $call,
  `$receiver.codePointAt($...)` as $call,
  `$receiver.endsWith($...)` as $call,
  `$receiver.localeCompare($...)` as $call,
  `$receiver.match($...)` as $call,
  `$receiver.matchAll($...)` as $call,
  `$receiver.normalize($...)` as $call,
  `$receiver.padEnd($...)` as $call,
  `$receiver.padStart($...)` as $call,
  `$receiver.repeat($...)` as $call,
  `$receiver.replace($...)` as $call,
  `$receiver.replaceAll($...)` as $call,
  `$receiver.search($...)` as $call,
  `$receiver.split($...)` as $call,
  `$receiver.startsWith($...)` as $call,
  `$receiver.substring($...)` as $call,
  `$receiver.toLocaleLowerCase($...)` as $call,
  `$receiver.toLocaleUpperCase($...)` as $call,
  `$receiver.toLowerCase($...)` as $call,
  `$receiver.toUpperCase($...)` as $call,
  `$receiver.trim($...)` as $call,
  `$receiver.trimEnd($...)` as $call,
  `$receiver.trimStart($...)` as $call,
  `String.fromCharCode($...)` as $call,
  `String.fromCodePoint($...)` as $call,
  `String.raw($...)` as $call
} where {
  $call <: not or {
    `Str.$method($...)`,
    `Arr.$method($...)`,
    `Effect.$method($...)`,
    `Option.$method($...)`,
    `Result.$method($...)`,
    `Schema.$method($...)`,
    `Flag.$method($...)`,
    `$definition.expression.match($...)`
  },
  register_diagnostic(span=$call, message="Use effect/String instead of native String methods.")
}
