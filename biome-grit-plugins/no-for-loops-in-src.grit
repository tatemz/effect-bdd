engine biome(1.0)
language js(typescript, jsx)

or {
  JsForStatement() as $loop,
  JsForOfStatement() as $loop,
  JsForInStatement() as $loop
} where {
  register_diagnostic(span=$loop, message="Use Effect.forEach, Arr.*, Record.*, or Iterable.* from the Effect standard library instead of for loops.")
}
