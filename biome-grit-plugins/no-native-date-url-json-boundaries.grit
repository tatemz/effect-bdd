engine biome(1.0)
language js(typescript, jsx)

or {
  `new Date($...)` as $call,
  `Date.now($...)` as $call,
  `Date.parse($...)` as $call,
  `Date.UTC($...)` as $call,
  `new URL($...)` as $call,
  `URL.parse($...)` as $call,
  `URL.canParse($...)` as $call,
  `new URLSearchParams($...)` as $call,
  `JSON.parse($...)` as $call,
  `JSON.stringify($...)` as $call
} where {
  register_diagnostic(span=$call, message="Use effect/Clock or effect/DateTime for time, Effect platform services for URLs, and effect/Schema codecs for JSON at serialization boundaries.")
}
