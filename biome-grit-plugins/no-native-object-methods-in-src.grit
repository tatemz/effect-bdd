engine biome(1.0)
language js(typescript, jsx)

or {
  `Object.assign($...)` as $call,
  `Object.entries($...)` as $call,
  `Object.fromEntries($...)` as $call,
  `Object.hasOwn($...)` as $call,
  `Object.keys($...)` as $call,
  `Object.values($...)` as $call
} where { register_diagnostic(span=$call, message="Use effect/Record instead of native Object dictionary methods.") }
