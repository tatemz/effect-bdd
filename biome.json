{
  "$schema": "https://biomejs.dev/schemas/2.4.16/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "ignoreUnknown": true,
    "includes": ["**", "!biome-grit-plugins/fixtures", "!pnpm-lock.yaml"]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 120
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "semicolons": "asNeeded",
      "trailingCommas": "none",
      "arrowParentheses": "always"
    }
  },
  "json": {
    "formatter": {
      "trailingCommas": "none"
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "suspicious": {
        "noExplicitAny": "off",
        "useIterableCallbackReturn": "off",
        "noThenProperty": "off"
      },
      "complexity": {
        "noBannedTypes": "off",
        "noArguments": "off"
      }
    }
  },
  "plugins": [
    "./biome-grit-plugins/no-inline-nested-effect-gen.grit",
    "./biome-grit-plugins/no-process-env.grit",
    "./biome-grit-plugins/no-effect-or-die.grit"
  ],
  "overrides": [
    {
      "includes": ["src/**"],
      "plugins": [
        "./biome-grit-plugins/no-for-loops-in-src.grit",
        "./biome-grit-plugins/no-native-array-methods-in-src.grit",
        "./biome-grit-plugins/no-native-string-methods-in-src.grit",
        "./biome-grit-plugins/no-native-object-methods-in-src.grit",
        "./biome-grit-plugins/no-effect-named-imports-in-src.grit",
        "./biome-grit-plugins/no-throw-statements.grit",
        "./biome-grit-plugins/no-try-catch.grit"
      ]
    },
    {
      "includes": ["src/**", "!src/internal/cli/reporter.ts"],
      "plugins": ["./biome-grit-plugins/no-native-date-url-json-boundaries.grit"]
    }
  ]
}
